# =============================================================================
# Environment Variables for Development
# =============================================================================
# Copy this file to .env and update values

# App Configuration
NODE_ENV=development
APP_PORT=5000
APP_PREFIX=/api/v1

# CORS
CORS_WHITELIST=http://localhost:8080,http://localhost:3000

# Timezone
TIMEZONE_DEFAULT=+00:00
TIMEZONE_DEFAULT_NAME=UTC

# Logging
LOG_ENABLE_LOG_TO_FILE=true
LOG_ROOT_FOLDER=logs/winston
LOG_MAX_FILES=10
LOG_MAX_SIZE=10000000
LOG_LEVEL=debug

# Database (for Docker Compose)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DATABASE=nestjs_dev

# JWT Authentication
JWT_ACCESS_TOKEN_SECRET_KEY=dev-jwt-secret-change-in-production
JWT_ACCESS_TOKEN_EXPIRED_IN=86400
JWT_REFRESH_TOKEN_SECRET_KEY=dev-refresh-secret-change-in-production
JWT_REFRESH_TOKEN_EXPIRED_IN=604800

# AWS (for local AWS SDK usage)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=fake-access-key
AWS_SECRET_ACCESS_KEY=fake-secret-key
AWS_S3_BUCKET=fake-bucket-name
CLOUD_FRONT_URL=https://fake.cloudfront.net
AWS_S3_SIGNED_URL_EXPIRED_IN_SECOND=3600

# Docker Compose Ports
POSTGRES_EXTERNAL_PORT=5432
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@localhost.com
PGADMIN_PASSWORD=admin123
REDIS_PORT=6379
REDIS_PASSWORD=redis123
DEBUG_PORT=9229
